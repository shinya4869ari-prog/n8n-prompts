            {
              "fieldLabel": "neko_comment",
              "fieldType": "text",
              "requiredField": false,
              "fieldDescription": "【任意】エラーネコの一言を指定したい場合に入力（空欄の場合は自動生成）"
            }
          ]
        },
        "options": {}
      },
