// 貿易データの集約と整理
const countryJp = $input.first().json["国名（日本語）"];
const e = (i, col) => $items("輸出").find(item => item.json.順位 === (i + 1))?.json[col] || "";
const im = (i, col) => $items("輸入").find(item => item.json.順位 === (i + 1))?.json[col] || "";
const pt = (i, col) => $items("貿易相手国").find(item => item.json.順位 === (i + 1))?.json[col] || "";

// 貿易相手10位の後にある独立した出典データを取得
const tradeCite = $items("貿易相手国").find(item => !item.json.順位 && item.json.出典)?.json.出典 
               || $items("貿易相手国").last()?.json.出典 
               || "IMF / Trade Map";

return [{ json: {
  "国名（日本語）": countryJp,
  "貿易統計_出典": tradeCite,
  // 輸出
  "輸出1位_品目": e(0,"品目"), "輸出2位_品目": e(1,"品目"), "輸出3位_品目": e(2,"品目"),
  "輸出4位_品目": e(3,"品目"), "輸出5位_品目": e(4,"品目"), "輸出6位_品目": e(5,"品目"),
  "輸出7位_品目": e(6,"品目"), "輸出8位_品目": e(7,"品目"), "輸出9位_品目": e(8,"品目"),
  "輸出10位_品目": e(9,"品目"),
  // 輸入
  "輸入1位_品目": im(0,"品目"), "輸入2位_品目": im(1,"品目"), "輸入3位_品目": im(2,"品目"),
  "輸入4位_品目": im(3,"品目"), "輸入5位_品目": im(4,"品目"), "輸入6位_品目": im(5,"品目"),
  "輸入7位_品目": im(6,"品目"), "輸入8位_品目": im(7,"品目"), "輸入9位_品目": im(8,"品目"),
  "輸入10位_品目": im(9,"品目"),
  // 相手国
  "貿易相手1位_国名": pt(0,"国名"), "貿易相手1位_シェア%": pt(0,"シェア"),
  "貿易相手2位_国名": pt(1,"国名"), "貿易相手2位_シェア%": pt(1,"シェア"),
  "貿易相手3位_国名": pt(2,"国名"), "貿易相手3位_シェア%": pt(2,"シェア"),
  "貿易相手4位_国名": pt(3,"国名"), "貿易相手4位_シェア%": pt(3,"シェア"),
  "貿易相手5位_国名": pt(4,"国名"), "貿易相手5位_シェア%": pt(4,"シェア"),
