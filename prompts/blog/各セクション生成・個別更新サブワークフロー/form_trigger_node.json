        "formFields": {
          "values": [
            {
              "fieldLabel": "country",
              "fieldType": "text",
              "requiredField": true,
              "defaultValue": "韓国",
              "fieldDescription": "対象国名を入力してください（例: 韓国、ブータン、アメリカ）"
            },
            {
              "fieldLabel": "section_type",
              "fieldType": "dropdown",
              "requiredField": true,
              "fieldOptions": {
                "values": [
                  {
                    "option": "chian : ③ 治安と平和の衡量"
                  },
                  {
                    "option": "bukka : ⑤ 生活・価値の衡量（物価比較）"
                  },
                  {
                    "option": "eizou : ⑧ 映像作品"
                  },
                  {
                    "option": "osusume : ⑨ おすすめ映画"
                  },
                  {
                    "option": "music : ⑩ おすすめ音楽"
                  },
                  {
                    "option": "doukou : ⑦ 直近の動向"
                  },
                  {
                    "option": "boeki : ④ 貿易の衡量"
                  },
                  {
                    "option": "rekishi : ⑥ 歴史的背景"
                  },
                  {
                    "option": "deep_dive : ✦ Deep Dive"
                  }
                ]
              },
              "defaultValue": "chian : ③ 治安と平和の衡量",
